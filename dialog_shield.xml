<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Escudos" android:textColor="@color/cz_text" android:textSize="20sp" android:textStyle="bold" />
    <TextView android:id="@+id/sh_host" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/cz_muted" android:textSize="14sp" />
    <TextView android:id="@+id/sh_page" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="0" android:textColor="@color/cz_primary" android:textSize="44sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="bloqueados en esta página" android:textColor="@color/cz_text" android:textSize="14sp" />
    <TextView android:id="@+id/sh_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/cz_muted" android:textSize="13sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Bloqueo en este sitio" android:textColor="@color/cz_text" android:textSize="16sp" />
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/sh_switch" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
