<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/cz_bg" android:orientation="vertical">

    <LinearLayout android:id="@+id/top_bar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/cz_surface" android:gravity="center_vertical" android:padding="10dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
            android:background="@drawable/bg_pill" android:gravity="center_vertical">
            <LinearLayout android:id="@+id/shield_btn" android:layout_width="wrap_content" android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless" android:gravity="center"
                android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="8dp">
                <ImageView android:id="@+id/shield_icon" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_shield" />
                <TextView android:id="@+id/shield_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="5dp" android:text="0" android:textColor="@color/cz_primary" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <EditText android:id="@+id/url_bar" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:background="@null" android:hint="Buscar o escribir dirección" android:imeOptions="actionGo"
                android:importantForAutofill="no" android:inputType="textUri" android:maxLines="1"
                android:textColor="@color/cz_text" android:textColorHint="@color/cz_muted" android:textSize="15sp" />
            <ImageButton android:id="@+id/btn_star" android:layout_width="40dp" android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Favorito" android:src="@drawable/ic_star" android:tint="@color/cz_muted" />
            <ImageButton android:id="@+id/btn_reload" android:layout_width="40dp" android:layout_height="match_parent"
                android:layout_marginEnd="4dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Recargar" android:src="@drawable/ic_reload" android:tint="@color/cz_muted" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent"
        android:layout_height="2dp" android:max="100" android:progressTint="@color/cz_primary" android:progressBackgroundTint="@color/cz_surface" />

    <FrameLayout android:id="@+id/container" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:background="@color/cz_surface">
        <ImageButton android:id="@+id/btn_back" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Atrás" android:src="@drawable/ic_back" android:tint="@color/cz_text" />
        <ImageButton android:id="@+id/btn_forward" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Adelante" android:src="@drawable/ic_forward" android:tint="@color/cz_text" />
        <ImageButton android:id="@+id/btn_home" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Inicio" android:src="@drawable/ic_home" android:tint="@color/cz_text" />
        <FrameLayout android:id="@+id/btn_tabs" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true">
            <TextView android:id="@+id/tabs_count" android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center"
                android:background="@drawable/bg_tabbox" android:gravity="center" android:text="1" android:textColor="@color/cz_text" android:textSize="12sp" android:textStyle="bold" />
        </FrameLayout>
        <ImageButton android:id="@+id/btn_menu" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Menú" android:src="@drawable/ic_menu" android:tint="@color/cz_text" />
    </LinearLayout>
</LinearLayout>
